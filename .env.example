# Brownsea Pipeline environment
BROWSEA_ENV=local
BROWSEA_DATA_DIR=./data
BROWSEA_OUTPUT_DIR=./outputs
ORS_API_KEY=your_openrouteservice_key_here
LOG_LEVEL=INFO

# Optional AI assistant in the Flask app (leave the key unset to keep it off)
ANTHROPIC_API_KEY=
BROWNSEA_AGENT_MODEL=claude-sonnet-5-5
BROWNSEA_AGENT_RATE_PER_MIN=10
