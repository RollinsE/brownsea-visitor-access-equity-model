# Brownsea Pipeline environment
BROWSEA_ENV=local
BROWSEA_DATA_DIR=./data
BROWSEA_OUTPUT_DIR=./outputs
ORS_API_KEY=your_openrouteservice_key_here
LOG_LEVEL=INFO

# Optional AI assistant in the Flask app (leave the key unset to keep it off)
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
BROWNSEA_AGENT_MODEL=gemini-3.8-flash
BROWNSEA_AGENT_RATE_PER_MIN=10
# To use Anthropic instead: pip install anthropic, set ANTHROPIC_API_KEY and BROWNSEA_AGENT_PROVIDER=anthropic
